# Copy to .env.local for local development (never commit .env.local).
# Local values come from `supabase start` output; production values from
# your hosted Supabase project's API settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# On first login with this email, the profile is created with the
# master_admin role. See taskdeck-spec.md §12.
SEED_MASTER_ADMIN_EMAIL=

# Authorizes Vercel Cron's daily call to /api/generate-instances (see
# vercel.json). Vercel sets this automatically for Cron-triggered
# requests once the env var exists in the project — generate any random
# string for it. Not required for local dev (admins can trigger
# generation manually while signed in).
CRON_SECRET=
