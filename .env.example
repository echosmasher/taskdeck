# Copy to .env.local for local development (never commit .env.local).
# Local values come from `supabase start` output; production values from
# your hosted Supabase project's API settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# On first login with this email, the profile is created with the
# master_admin role. See taskdeck-spec.md §12.
SEED_MASTER_ADMIN_EMAIL=

# Authorizes Vercel Cron's daily call to /api/generate-instances (see
# vercel.json). Vercel sets this automatically for Cron-triggered
# requests once the env var exists in the project — generate any random
# string for it. Not required for local dev (admins can trigger
# generation manually while signed in).
CRON_SECRET=

# Fixed demo-account credentials (spec §9) — the "Explore as Admin" /
# "Explore as Member" landing-page buttons sign in with these
# server-side; the raw values are never sent to the browser. Required
# for `pnpm seed`, which creates/updates these two accounts every run.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_MEMBER_EMAIL=
DEMO_MEMBER_PASSWORD=

# Set to exactly "true" to turn on the public demo experience (task
# 22): the login page becomes the "Explore as Admin/Member" landing,
# every page shows the "Demo environment" banner, and /api/reset-demo
# (nightly via vercel.json + an admin "Reset demo data" button on
# Settings) becomes reachable. Leave unset on a real deployment —
# /api/reset-demo wipes every company/task/instance in the database
# and this flag is the only thing gating it.
DEMO_MODE=
